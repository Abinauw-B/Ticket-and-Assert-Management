								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Screen flickering (Severe)\",\n    \"description\": \"Now the screen keeps flickering and goes black for 2-3 seconds at a time.\",\n    \"priority\": \"HIGH\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/1",
							"host": [
								"{{baseUrl}}"
