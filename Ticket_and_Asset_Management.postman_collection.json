						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "employee1",
									"type": "string"
								},
								{
									"key": "password",
									"value": "emp123",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Overheating laptop\",\n    \"description\": \"My MacBook Pro gets extremely hot near the touch bar and the fan starts spinning loudly even with low usage.\",\n    \"priority\": \"MEDIUM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets?assetId=1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets"
							],
							"query": [
								{
									"key": "assetId",
									"value": "1",
									"description": "Associates this ticket with MacBook Pro (ID: 1)"
								}
							]
						},
						"description": "Creates a new ticket. The creator is automatically set to Employee 1. The ticket is associated with Asset ID 1."
					},
					"response": []
				},
