								{
									"key": "password",
									"value": "emp123",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tickets/2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
