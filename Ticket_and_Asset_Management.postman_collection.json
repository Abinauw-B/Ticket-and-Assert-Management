						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Screen flickering issue\",\n    \"description\": \"My MacBook Pro screen has started flickering intermittently, especially when connected to the external charger.\",\n    \"priority\": \"HIGH\",\n    \"status\": \"RESOLVED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"1"
							]
						},
						"description": "Allows an Admin to update any ticket's status (e.g. transitioning from OPEN to IN_PROGRESS, RESOLVED, or CLOSED)."
					},
					"response": []
				},
				{
					"name": "Delete Open Ticket (Employee 2)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "employee2",
									"type": "string"
